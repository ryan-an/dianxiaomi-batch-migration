{
  "manifest_version": 3,
  "name": "店小秘批量迁移助手",
  "version": "0.4.38",
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "description": "本地解析迁移表，按链接映射采集标题，认领、填写并发布，保留逐条执行结果。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.dianxiaomi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
    "default_title": "显示网页内迁移面板"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dianxiaomi.com/web/amazon/*",
        "https://www.dianxiaomi.com/web/productCrawl/*"
      ],
      "js": [
        "vendor/xlsx.full.min.js",
        "core.js",
        "ui-model.js",
        "work-target.js",
        "batch-state.js",
        "adapter.js",
        "panel-layout.js",
        "panel-view.js",
        "overlay.js",
        "popup.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.dianxiaomi.com/web/amazon/*"
      ],
      "js": [
        "editor-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.dianxiaomi.com/api/meituv2/editor.htm*"],
      "js": ["image-editor.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
